# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residencia_db?schema=public"

# Orígenes Permitidos para CORS (Frontend)
CORS_ORIGIN="http://localhost:5173"
# En producción, 0 salvo que haya una cantidad conocida de proxies de confianza.
TRUST_PROXY_HOPS=0

# Autenticación JWT
# Generar un valor aleatorio y configurarlo fuera del repositorio para producción.
JWT_SECRET=
JWT_EXPIRES_IN="7d"
