# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residencia_db?schema=public"

# Orígenes Permitidos para CORS (Frontend)
CORS_ORIGIN="http://localhost:5173"

# Autenticación JWT
JWT_SECRET="clave_secreta_para_firmar_tokens_jwt"
JWT_EXPIRES_IN="7d"
