// prisma/schema.prisma
// Configuración del generador de cliente Prisma y datasource para PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// AUTENTICACIÓN, ROLES Y USUARIOS
// ==========================================

model Rol {
  idRol    Int       @id @default(autoincrement())
  rol      String    @unique
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  idUsuario               Int                      @id @default(autoincrement())
  idAlumno                Int?                     @unique
  correo                  String                   @unique
  contrasenaHash          String                   @map("contrasenaHash")
  idRol                   Int
  estado                  String                   @default("activo") // "pendiente" | "activo" | "suspendido" | "inactivo"
  gestionaAdministradores Boolean                  @default(false)
  fechaAlta               DateTime                 @default(now())
  nombre                  String?
  apellido                String?
  documento               String?
  telefono                String?

  // Relaciones
  rol                     Rol                      @relation(fields: [idRol], references: [idRol])
  alumno                  Alumno?                  @relation(fields: [idAlumno], references: [idAlumno], onDelete: SetNull)
  sesiones                Sesion[]
  tokensRestablecimiento  TokenRestablecimiento[]
  notificaciones          Notificacion[]
  cambiosAdministrativos  CambioAdministrativo[]
  seguimientosReclamos    SeguimientoReclamo[]

  @@map("usuarios")
}

model Sesion {
  idSesion   Int       @id @default(autoincrement())
  idUsuario  Int
  tokenHash  String    @unique
  creadaEn   DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?

  usuario    Usuario   @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("sesiones")
}

model TokenRestablecimiento {
  idToken   Int       @id @default(autoincrement())
  idUsuario Int
  tokenHash String    @unique
  creadoEn  DateTime  @default(now())
  expiraEn  DateTime
  usadoEn   DateTime?

  usuario   Usuario   @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("tokens_restablecimiento")
}

model Notificacion {
  idNotificacion Int       @id @default(autoincrement())
  idUsuario      Int
  claveEvento    String
  tipo           String    @default("info") // "info", "alerta", "vencimiento", "sancion"
  titulo         String
  detalle        String
  destino        String    @default("")
  creadaEn       DateTime  @default(now())
  leidaEn        DateTime?

  usuario        Usuario   @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@map("notificaciones")
}

model CambioAdministrativo {
  idCambio   Int      @id @default(autoincrement())
  idActor    Int
  fecha      DateTime @default(now())
  seccion    String
  accion     String
  referencia String?
  detalle    String

  actor      Usuario  @relation(fields: [idActor], references: [idUsuario], onDelete: Cascade)

  @@map("cambios_administrativos")
}

// ==========================================
// ALUMNOS Y CONTACTOS DE EMERGENCIA
// ==========================================

model Alumno {
  idAlumno                 Int                   @id @default(autoincrement())
  nombre                   String
  apellido                 String
  documento                String                @unique
  telefono                 String?
  correoContacto           String?
  estado                   String                @default("activo") // "activo" | "inactivo"
  fechaNacimiento          DateTime?
  nacionalidad             String?
  domicilio                String?
  localidad                String?
  provincia                String?
  codigoPostal             String?
  institucion              String?
  carrera                  String?
  anioCursado              String?
  cantidadMateriasCursadas Int?
  legajo                   String?
  observaciones            String?

  // Relaciones
  usuario                  Usuario?
  contactosEmergencia      ContactoEmergencia[]
  contratos                Contrato[]
  pagos                    Pago[]
  facturas                 Factura[]
  cuotasMensuales          CuotaMensual[]
  multas                   Multa[]
  habitacionesAlumnos      HabitacionAlumno[]
  grupoLimpiezaAlumno      GrupoLimpiezaAlumno?
  reclamos                 Reclamo[]

  @@map("alumnos")
}

model ContactoEmergencia {
  idContacto Int     @id @default(autoincrement())
  idAlumno   Int
  nombre     String
  vinculo    String
  telefono   String
  orden      Int     @default(1)

  alumno     Alumno  @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)

  @@map("contactos_emergencia")
}

// ==========================================
// HABITACIONES Y OCUPACIÓN
// ==========================================

model Habitacion {
  idHabitacion     Int                @id @default(autoincrement())
  numeroHabitacion String             @unique
  capacidadMaxima  Int
  pisoHabitacion   Int?
  descripcion      String?

  // Relaciones
  habitacionesAlumnos HabitacionAlumno[]

  @@map("habitaciones")
}

model HabitacionAlumno {
  idAsignacion Int        @id @default(autoincrement())
  idHabitacion Int
  idAlumno     Int
  fechaDesde   DateTime
  fechaHasta   DateTime?

  habitacion   Habitacion @relation(fields: [idHabitacion], references: [idHabitacion], onDelete: Cascade)
  alumno       Alumno     @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)

  @@unique([idHabitacion, idAlumno, fechaDesde])
  @@map("habitaciones_alumnos")
}

// ==========================================
// CONTRATOS, FACTURACIÓN Y PAGOS
// ==========================================

model Contrato {
  idContrato         Int       @id @default(autoincrement())
  idAlumno           Int
  fechaDesde         DateTime
  fechaHasta         DateTime
  fechaFirma         DateTime?
  montoMensual       Decimal   @default(180000.00) @db.Decimal(12, 2)
  depositoGarantia   Decimal   @default(0.00) @db.Decimal(12, 2)
  diaVencimientoPago Int       @default(10)
  observaciones      String?
  fechaCancelacion   DateTime?
  motivoCancelacion  String?
  estado             String    @default("VIGENTE") // "VIGENTE", "FINALIZADO", "CANCELADO", "POR_VENCER"

  alumno             Alumno    @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)
  facturas           Factura[]

  @@map("contratos")
}

model Factura {
  idFactura         Int              @id @default(autoincrement())
  idContrato        Int
  idAlumno          Int?
  periodo           String           // "2026-10"
  fechaEmision      DateTime         @default(now())
  fechaVence        DateTime
  titular           String
  documento         String
  fechaCancelacion  DateTime?
  motivoCancelacion String?
  idFacturaOrigen   Int?
  creditoAplicado   Decimal          @default(0.00) @db.Decimal(12, 2)

  contrato          Contrato         @relation(fields: [idContrato], references: [idContrato], onDelete: Cascade)
  alumno            Alumno?          @relation(fields: [idAlumno], references: [idAlumno], onDelete: SetNull)
  facturaOrigen     Factura?         @relation("ReemplazosFactura", fields: [idFacturaOrigen], references: [idFactura], onDelete: SetNull)
  reemplazos        Factura[]        @relation("ReemplazosFactura")
  detalles          DetalleFactura[]
  pagos             Pago[]

  @@map("facturas")
}

model DetalleFactura {
  idDetalle Int     @id @default(autoincrement())
  idFactura Int
  idMulta   Int?
  concepto  String
  monto     Decimal @db.Decimal(12, 2)
  orden     Int     @default(1)

  factura   Factura @relation(fields: [idFactura], references: [idFactura], onDelete: Cascade)
  multa     Multa?  @relation(fields: [idMulta], references: [idMulta], onDelete: SetNull)

  @@map("detalles_factura")
}

model Pago {
  idPago     Int      @id @default(autoincrement())
  idAlumno   Int
  idFactura  Int?
  monto      Decimal  @db.Decimal(12, 2)
  fecha      DateTime @default(now())
  concepto   String
  medio      String?  // "efectivo", "transferencia", "tarjeta"
  referencia String?

  alumno     Alumno   @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)
  factura    Factura? @relation(fields: [idFactura], references: [idFactura], onDelete: SetNull)

  @@map("pagos")
}

// Modelo transitorio para compatibilidad con código existente de cuotas
model CuotaMensual {
  idCuota      Int      @id @default(autoincrement())
  idAlumno     Int
  fechaEmision DateTime @default(now())
  mesAsociado  String
  montoPagado  Decimal  @db.Decimal(12, 2)
  estadoCuota  String   // "PENDIENTE", "PAGADA", "VENCIDA"

  alumno       Alumno   @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)

  @@map("cuotas_mensuales")
}

// ==========================================
// MULTAS Y AUDITORÍA DE CAMBIOS
// ==========================================

model Multa {
  idMulta           Int              @id @default(autoincrement())
  idAlumno          Int
  idEmision         String?
  tipo              String           @default("leve")
  motivo            String
  observaciones     String?
  huboDanios        Boolean          @default(false)
  detalleDanios     String?
  monto             Decimal          @db.Decimal(12, 2)
  montoSancion      Decimal          @default(0.00) @db.Decimal(12, 2)
  montoDanios       Decimal          @default(0.00) @db.Decimal(12, 2)
  recargoPorcentaje Decimal          @default(0.00) @db.Decimal(5, 2)
  fechaEmision      DateTime         @default(now())
  fechaVence        DateTime
  periodoDesde      String?
  periodoHasta      String?
  estadoMulta       String           @default("PENDIENTE") // "PENDIENTE", "PAGADA", "ANULADA"
  fechaPago         DateTime?
  montoPagado       Decimal?         @db.Decimal(12, 2)

  alumno            Alumno           @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)
  detallesFactura   DetalleFactura[]
  cambios           CambioMulta[]

  @@map("multas")
}

model CambioMulta {
  idCambio Int      @id @default(autoincrement())
  idMulta  Int
  fecha    DateTime @default(now())
  accion   String   // "edicion", "prorroga"
  motivo   String?
  cambios  Json     // [{ campo, anterior, nuevo }]

  multa    Multa    @relation(fields: [idMulta], references: [idMulta], onDelete: Cascade)

  @@map("cambios_multa")
}

// ==========================================
// LIMPIEZA Y AMBIENTES
// ==========================================

model GrupoDeLimpieza {
  idGrupoLimpieza Int    @id @default(autoincrement())
  nombreDelGrupo  String @unique
  posicionInicial Int    @unique @default(1)

  gruposLimpiezaAlumnos   GrupoLimpiezaAlumno[]
  gruposLimpiezaAmbientes GrupoLimpiezaAmbiente[]

  @@map("grupos_de_limpieza")
}

model GrupoLimpiezaAlumno {
  idAlumno        Int             @id @unique
  idGrupoLimpieza Int

  alumno          Alumno          @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)
  grupoLimpieza   GrupoDeLimpieza @relation(fields: [idGrupoLimpieza], references: [idGrupoLimpieza], onDelete: Cascade)

  @@unique([idGrupoLimpieza, idAlumno])
  @@map("grupos_limpieza_alumnos")
}

model Ambiente {
  idAmbiente  Int       @id @default(autoincrement())
  nombre      String    @unique @map("ambiente")
  tipo        String?   // "Sala de estudio", "Baño", "Cocina", "Duchas", "Comedor", "Lavadero", "Otro"
  ubicacion   String?
  descripcion String?
  tareas      String?   @default("")

  equipamiento            EquipamientoAmbiente[]
  gruposLimpiezaAmbientes GrupoLimpiezaAmbiente[]

  @@map("ambientes")
}

model EquipamientoAmbiente {
  idEquipamiento Int      @id @default(autoincrement())
  idAmbiente     Int
  nombre         String
  cantidad       Int      @default(1)

  ambiente       Ambiente @relation(fields: [idAmbiente], references: [idAmbiente], onDelete: Cascade)

  @@map("equipamiento_ambientes")
}

model GrupoLimpiezaAmbiente {
  idAsignacion    Int             @id @default(autoincrement())
  idGrupoLimpieza Int
  idAmbiente      Int
  fechaDesde      DateTime
  fechaHasta      DateTime?

  grupoLimpieza   GrupoDeLimpieza @relation(fields: [idGrupoLimpieza], references: [idGrupoLimpieza], onDelete: Cascade)
  ambiente        Ambiente        @relation(fields: [idAmbiente], references: [idAmbiente], onDelete: Cascade)

  @@unique([idGrupoLimpieza, idAmbiente, fechaDesde])
  @@map("grupos_limpieza_ambientes")
}

model TareaLimpieza {
  numero      Int      @id
  nombre      String   @unique
  enRotacion  Boolean  @default(true)
  actividades String[]

  @@map("tareas_limpieza")
}

// ==========================================
// RECLAMOS Y SEGUIMIENTOS
// ==========================================

model Reclamo {
  idReclamo          Int                  @id @default(autoincrement())
  idAlumno           Int
  tipo               String               @default("reclamo") // "reclamo", "solicitud", "problema"
  categoria          String               @default("mantenimiento") // "mantenimiento", "limpieza", "convivencia", "administracion", "otro"
  asunto             String
  descripcion        String
  ubicacion          String
  detalleUbicacion   String?
  prioridad          String               @default("normal") // "normal", "alta"
  estado             String               @default("pendiente") // "pendiente", "en_revision", "resuelto", "rechazado", "cancelado"
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt

  alumno             Alumno               @relation(fields: [idAlumno], references: [idAlumno], onDelete: Cascade)
  historial          SeguimientoReclamo[]

  @@map("reclamos")
}

model SeguimientoReclamo {
  idSeguimiento Int      @id @default(autoincrement())
  idReclamo     Int
  idAutor       Int?
  autor         String
  rol           String   // "administrador", "alumno"
  tipo          String   @default("comentario") // "creacion", "comentario", "estado"
  mensaje       String
  estado        String?  // EstadoReclamo opcional
  fecha         DateTime @default(now())

  reclamo       Reclamo  @relation(fields: [idReclamo], references: [idReclamo], onDelete: Cascade)
  usuarioAutor  Usuario? @relation(fields: [idAutor], references: [idUsuario], onDelete: SetNull)

  @@map("seguimientos_reclamos")
}

// ==========================================
// PARÁMETROS DEL SISTEMA
// ==========================================

model ParametroSistema {
  clave String  @id
  valor Decimal @db.Decimal(12, 2)

  @@map("parametros_sistema")
}

// ==========================================
// CATÁLOGOS DINÁMICOS
// ==========================================

model OpcionCatalogo {
  id            Int      @id @default(autoincrement())
  catalogo      String   // "carreras" | "vinculos"
  nombre        String
  activa        Boolean  @default(true)
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@unique([catalogo, nombre])
  @@map("opciones_catalogo")
}
